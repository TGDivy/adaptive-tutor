#!/usr/bin/env python3
"""Capture reproducible documentation media from the real local product."""

from __future__ import annotations

import hashlib
import importlib.metadata
import io
import json
import os
import shutil
import subprocess
import tempfile
import time
import urllib.request
from dataclasses import dataclass
from pathlib import Path
from typing import Any

import yaml
from PIL import Image
from playwright.sync_api import Browser, Page, sync_playwright
from rich.ansi import AnsiDecoder
from rich.console import Console
from rich.terminal_theme import MONOKAI
from rich.text import Text

ROOT = Path(__file__).resolve().parents[1]
OUTPUT = ROOT / "docs" / "assets" / "screenshots"
CAPTURE_ROOT = Path(tempfile.gettempdir()) / "adaptive-tutor-docs-capture"
PYTHON = ROOT / ".venv" / "bin" / "python"
ENTRYPOINT = "from adaptive_tutor.cli import app; app()"
SOURCE_FILES = (
    "src/adaptive_tutor/cli.py",
    "src/adaptive_tutor/dashboard.py",
    "src/adaptive_tutor/demo.py",
    "src/adaptive_tutor/reporting.py",
    "src/adaptive_tutor/static/app.css",
    "src/adaptive_tutor/templates/assignment.html",
    "src/adaptive_tutor/templates/dashboard.html",
    "curricula/systems-foundations/curriculum.yaml",
)
TERMINAL_HTML = """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
* { box-sizing: border-box; }
html, body { margin: 0; background: #e9eeeb; }
body { padding: 40px 50px; }
.terminal {
  width: 1180px;
  height: __HEIGHT__px;
  overflow: hidden;
  border: 1px solid #27332f;
  border-radius: 8px;
  background: #0f1513;
  box-shadow: 0 18px 48px rgb(23 34 30 / 18%);
}
.terminal-bar {
  height: 42px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 16px;
  border-bottom: 1px solid #27332f;
  color: #aebbb6;
  background: #17201d;
  font: 600 12px/1 Arial, sans-serif;
}
.terminal-bar i { width: 10px; height: 10px; border-radius: 50%; background: #7d8b85; }
.terminal-bar i:first-child { background: #dd7669; }
.terminal-bar i:nth-child(2) { background: #d6ad59; }
.terminal-bar i:nth-child(3) { margin-right: 8px; background: #61b98d; }
pre {
  margin: 0;
  padding: 22px 26px 28px;
  color: #d7e1dd;
  background: #0f1513;
  font: 15px/1.43 "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  letter-spacing: 0;
  white-space: pre-wrap;
}
</style>
</head>
<body>
<main class="terminal" aria-label="__TITLE__ terminal capture">
  <div class="terminal-bar"><i></i><i></i><i></i><span>__TITLE__</span></div>
  <pre>{code}</pre>
</main>
</body>
</html>
"""


@dataclass(frozen=True)
class CommandCapture:
    display: str
    output: str


def _clean_environment() -> dict[str, str]:
    return {
        "PATH": os.environ.get("PATH", ""),
        "HOME": str(CAPTURE_ROOT / "home"),
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "TERM": "xterm-256color",
        "COLUMNS": "100",
        "FORCE_COLOR": "1",
        "PYTHONUNBUFFERED": "1",
    }


def _run_cli(
    display: str, arguments: list[str], *, force_color: bool = True
) -> CommandCapture:
    environment = _clean_environment()
    if not force_color:
        environment.pop("FORCE_COLOR")
    result = subprocess.run(  # noqa: S603 - fixed local Python entrypoint and trusted arguments.
        [str(PYTHON), "-c", ENTRYPOINT, *arguments],
        cwd=ROOT,
        env=environment,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        check=False,
    )
    if result.returncode:
        raise RuntimeError(f"{display} failed:\n{result.stdout}")
    return CommandCapture(display=display, output=result.stdout)


def _terminal_html(title: str, captures: list[CommandCapture], height: int) -> str:
    target = io.StringIO()
    console = Console(
        file=target,
        record=True,
        width=100,
        force_terminal=True,
        color_system="truecolor",
    )
    decoder = AnsiDecoder()
    for index, capture in enumerate(captures):
        if index:
            console.print()
        console.print(Text(f"$ {capture.display}", style="bold #65d6ad"))
        for line in decoder.decode(capture.output):
            console.print(line)
    template = TERMINAL_HTML.replace("__HEIGHT__", str(height)).replace("__TITLE__", title)
    template = template.replace("{", "{{").replace("}", "}}").replace("{{code}}", "{code}")
    return console.export_html(theme=MONOKAI, inline_styles=True, code_format=template)


def _capture_terminal(
    page: Page,
    name: str,
    title: str,
    captures: list[CommandCapture],
    height: int,
) -> Path:
    page.set_viewport_size({"width": 1280, "height": height + 80})
    page.set_content(_terminal_html(title, captures, height), wait_until="load")
    path = OUTPUT / name
    page.locator(".terminal").screenshot(path=str(path))
    return path


def _wait_until_ready(port: int, process: subprocess.Popen[str]) -> None:
    deadline = time.monotonic() + 20
    url = f"http://127.0.0.1:{port}/readyz"
    while time.monotonic() < deadline:
        if process.poll() is not None:
            output, _ = process.communicate()
            raise RuntimeError(f"dashboard exited before readiness:\n{output}")
        try:
            with urllib.request.urlopen(url, timeout=1) as response:
                if response.status == 200:
                    return
        except OSError:
            time.sleep(0.1)
    raise RuntimeError("dashboard did not become ready within 20 seconds")


def _capture_dashboard(browser: Browser, config: Path, port: int) -> list[Path]:
    process = subprocess.Popen(  # noqa: S603 - fixed local Python entrypoint and trusted arguments.
        [str(PYTHON), "-c", ENTRYPOINT, "--config", str(config), "serve"],
        cwd=ROOT,
        env=_clean_environment(),
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
    )
    try:
        _wait_until_ready(port, process)
        captured: list[Path] = []
        errors: list[str] = []
        page = browser.new_page(viewport={"width": 1440, "height": 1000}, device_scale_factor=1)
        page.on(
            "console",
            lambda message: errors.append(message.text)
            if message.type == "error"
            else None,
        )
        page.goto(f"http://127.0.0.1:{port}/", wait_until="networkidle")
        page.locator(".dashboard-shell").wait_for(state="visible")
        dashboard = OUTPUT / "dashboard.png"
        page.screenshot(path=str(dashboard), full_page=True)
        captured.append(dashboard)

        page.goto(f"http://127.0.0.1:{port}/assignment/A-0007", wait_until="networkidle")
        page.locator(".assignment-shell").wait_for(state="visible")
        assignment = OUTPUT / "assignment-detail.png"
        page.screenshot(path=str(assignment), full_page=True)
        captured.append(assignment)
        page.close()

        mobile = browser.new_page(viewport={"width": 390, "height": 844}, device_scale_factor=1)
        mobile.on(
            "console",
            lambda message: errors.append(message.text)
            if message.type == "error"
            else None,
        )
        mobile.goto(f"http://127.0.0.1:{port}/", wait_until="networkidle")
        mobile.locator(".dashboard-shell").wait_for(state="visible")
        mobile_path = OUTPUT / "dashboard-mobile.png"
        mobile.screenshot(path=str(mobile_path), full_page=True)
        captured.append(mobile_path)
        mobile.close()
        if errors:
            raise RuntimeError("browser console errors: " + "; ".join(errors))
        return captured
    finally:
        process.terminate()
        try:
            process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait(timeout=5)


def _write_terminal_animation(frame_paths: list[Path]) -> Path:
    frames: list[Image.Image] = []
    for path in frame_paths:
        source = Image.open(path).convert("RGB")
        source.thumbnail((960, 700), Image.Resampling.LANCZOS)
        canvas = Image.new("RGB", (1000, 520), "#e9eeeb")
        offset = ((canvas.width - source.width) // 2, 20)
        canvas.paste(source, offset)
        frames.append(canvas)
    destination = OUTPUT / "terminal-tour.gif"
    frames[0].save(
        destination,
        save_all=True,
        append_images=frames[1:],
        duration=[1600] * len(frames),
        loop=0,
        optimize=True,
    )
    for frame in frames:
        frame.close()
    return destination


def _source_digest() -> str:
    digest = hashlib.sha256()
    for value in SOURCE_FILES:
        digest.update(value.encode())
        digest.update(b"\0")
        digest.update((ROOT / value).read_bytes())
        digest.update(b"\0")
    return "sha256:" + digest.hexdigest()


def _asset_record(path: Path, source: list[str]) -> dict[str, Any]:
    with Image.open(path) as image:
        width, height = image.size
        frames = getattr(image, "n_frames", 1)
    return {
        "path": path.relative_to(ROOT).as_posix(),
        "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
        "width": width,
        "height": height,
        "frames": frames,
        "source": source,
    }


def main() -> int:
    if not PYTHON.is_file():
        raise RuntimeError("sync the locked development environment before capturing screenshots")
    if CAPTURE_ROOT.exists():
        shutil.rmtree(CAPTURE_ROOT)
    (CAPTURE_ROOT / "home").mkdir(parents=True, mode=0o700)
    OUTPUT.mkdir(parents=True, exist_ok=True)

    init_config = CAPTURE_ROOT / "init" / "config.yaml"
    init_capture = _run_cli(
        "adaptive-tutor --config /tmp/adaptive-tutor-docs-capture/init/config.yaml init",
        [
            "--config",
            str(init_config),
            "init",
            "--data-dir",
            str(CAPTURE_ROOT / "init" / "state"),
        ],
    )
    doctor_capture = _run_cli(
        "adaptive-tutor --config …/config.yaml doctor --offline",
        ["--config", str(init_config), "doctor", "--offline"],
    )
    demo_root = CAPTURE_ROOT / "demo"
    demo_capture = _run_cli(
        "adaptive-tutor demo --keep /tmp/adaptive-tutor-docs-capture/demo",
        ["demo", "--keep", str(demo_root)],
        force_color=False,
    )
    demo_config = demo_root / "config.yaml"
    status_capture = _run_cli(
        "adaptive-tutor --config …/config.yaml status",
        ["--config", str(demo_config), "status"],
    )
    readiness_capture = _run_cli(
        "adaptive-tutor --config …/config.yaml readiness",
        ["--config", str(demo_config), "readiness"],
    )
    report_capture = _run_cli(
        "adaptive-tutor --config …/config.yaml report --period weekly",
        ["--config", str(demo_config), "report", "--period", "weekly"],
    )

    port = 8876
    config_payload = yaml.safe_load(demo_config.read_text(encoding="utf-8"))
    config_payload["server"]["port"] = port
    demo_config.write_text(yaml.safe_dump(config_payload, sort_keys=False), encoding="utf-8")
    demo_config.chmod(0o600)

    records: list[tuple[Path, list[str]]] = []
    with sync_playwright() as playwright:
        launch_args = ["--no-sandbox"] if os.geteuid() == 0 else []
        browser = playwright.chromium.launch(headless=True, args=launch_args)
        page = browser.new_page(viewport={"width": 1280, "height": 900}, device_scale_factor=1)
        terminal_paths = [
            _capture_terminal(page, "setup.png", "Secure setup", [init_capture], 360),
            _capture_terminal(page, "doctor.png", "System doctor", [doctor_capture], 580),
            _capture_terminal(
                page,
                "status-readiness.png",
                "Status and readiness",
                [status_capture, readiness_capture],
                560,
            ),
            _capture_terminal(
                page,
                "assignment-created.png",
                "Assignment creation",
                [demo_capture],
                540,
            ),
            _capture_terminal(page, "report.png", "Weekly report", [report_capture], 460),
        ]
        page.close()
        records.extend(
            [
                (terminal_paths[0], [init_capture.display]),
                (terminal_paths[1], [doctor_capture.display]),
                (
                    terminal_paths[2],
                    [status_capture.display, readiness_capture.display],
                ),
                (terminal_paths[3], [demo_capture.display]),
                (terminal_paths[4], [report_capture.display]),
            ]
        )
        for path in _capture_dashboard(browser, demo_config, port):
            records.append((path, [f"http://127.0.0.1:{port}/"]))
        browser.close()

    animation = _write_terminal_animation(terminal_paths)
    records.append((animation, ["setup.png", "doctor.png", "status-readiness.png", "report.png"]))
    manifest = {
        "schema_version": "1.0",
        "generator": "scripts/capture-screenshots",
        "playwright_version": importlib.metadata.version("playwright"),
        "source_files": list(SOURCE_FILES),
        "source_digest": _source_digest(),
        "assets": [_asset_record(path, source) for path, source in records],
    }
    (OUTPUT / "manifest.json").write_text(
        json.dumps(manifest, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    print(f"Captured {len(records)} product assets in {OUTPUT.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
