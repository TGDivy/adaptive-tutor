#!/usr/bin/env python3
"""Validate deployment artifacts without starting persistent services."""

from __future__ import annotations

import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any

import yaml

ROOT = Path(__file__).resolve().parents[1]


def require(condition: bool, message: str, failures: list[str]) -> None:
    if not condition:
        failures.append(message)


def load_compose(failures: list[str]) -> dict[str, Any]:
    path = ROOT / "deploy" / "compose.yaml"
    try:
        payload = yaml.safe_load(path.read_text(encoding="utf-8"))
    except (OSError, yaml.YAMLError) as exc:
        failures.append(f"compose file is unreadable: {exc}")
        return {}
    if not isinstance(payload, dict):
        failures.append("compose file must contain a mapping")
        return {}
    return payload


def validate_compose(payload: dict[str, Any], failures: list[str]) -> None:
    services = payload.get("services")
    require(isinstance(services, dict), "compose services are missing", failures)
    if not isinstance(services, dict):
        return
    require(
        {"tutor", "worker", "grader", "initializer", "operator", "proxy"}.issubset(
            services
        ),
        "compose must define tutor, worker, grader, initializer, operator, and proxy services",
        failures,
    )
    for name in ("tutor", "worker", "grader", "initializer", "operator"):
        service = services.get(name, {})
        if not isinstance(service, dict):
            failures.append(f"compose service {name} is invalid")
            continue
        require(service.get("read_only") is True, f"{name} root must be read-only", failures)
        require(service.get("cap_drop") == ["ALL"], f"{name} must drop capabilities", failures)
        require(
            "no-new-privileges:true" in service.get("security_opt", []),
            f"{name} must disable privilege escalation",
            failures,
        )
    tutor = services.get("tutor", {})
    ports = tutor.get("ports", []) if isinstance(tutor, dict) else []
    require(
        bool(ports) and all(str(item).startswith("127.0.0.1:") for item in ports),
        "dashboard ports must be loopback-bound",
        failures,
    )
    worker = services.get("worker", {})
    grader = services.get("grader", {})
    operator = services.get("operator", {})
    proxy = services.get("proxy", {})
    require(
        isinstance(worker, dict) and "remote" in worker.get("profiles", []),
        "remote worker must be explicitly profile-gated",
        failures,
    )
    require(
        isinstance(operator, dict) and operator.get("profiles") == ["tools"],
        "trusted setup operator must be explicitly tools-profile gated",
        failures,
    )
    tutor_env = str(tutor.get("env_file", "")) if isinstance(tutor, dict) else ""
    worker_env = str(worker.get("env_file", "")) if isinstance(worker, dict) else ""
    grader_env = str(grader.get("env_file", "")) if isinstance(grader, dict) else ""
    require("worker.env" not in tutor_env, "model credentials reached tutor service", failures)
    require("worker.env" in worker_env, "worker environment file is missing", failures)
    require("grader.env" not in worker_env, "model credentials reached worker service", failures)
    require("grader.env" in grader_env, "grader-only environment file is missing", failures)
    grader_volumes = grader.get("volumes", []) if isinstance(grader, dict) else []
    worker_volumes = worker.get("volumes", []) if isinstance(worker, dict) else []
    operator_volumes = operator.get("volumes", []) if isinstance(operator, dict) else []
    tutor_volumes = tutor.get("volumes", []) if isinstance(tutor, dict) else []
    grader_targets = _volume_targets(grader_volumes)
    worker_targets = _volume_targets(worker_volumes)
    operator_targets = _volume_targets(operator_volumes)
    tutor_config_mounts = [
        str(volume) for volume in tutor_volumes if ":/etc/adaptive-tutor" in str(volume)
    ]
    worker_config_mounts = [
        str(volume) for volume in worker_volumes if ":/etc/adaptive-tutor" in str(volume)
    ]
    require(
        len(tutor_config_mounts) == 1
        and tutor_config_mounts[0].endswith(":/etc/adaptive-tutor"),
        "tutor config mount must support authenticated browser setup writes",
        failures,
    )
    require(
        len(worker_config_mounts) == 1
        and worker_config_mounts[0].endswith(":/etc/adaptive-tutor:ro"),
        "worker config mount must remain read-only",
        failures,
    )
    require(
        "/etc/adaptive-tutor" in operator_targets
        and "/var/lib/adaptive-tutor" in operator_targets
        and "/run/adaptive-tutor-grader" in operator_targets,
        "setup operator requires config, state, and read-only grader socket access",
        failures,
    )
    operator_socket_mounts = [
        str(volume)
        for volume in operator_volumes
        if ":/run/adaptive-tutor-grader" in str(volume)
    ]
    require(
        len(operator_socket_mounts) == 1
        and operator_socket_mounts[0].endswith(":/run/adaptive-tutor-grader:ro"),
        "setup operator grader socket volume must be read-only",
        failures,
    )
    require(
        "/var/lib/adaptive-tutor" not in grader_targets,
        "grader can read tutor state",
        failures,
    )
    require(
        "/etc/adaptive-tutor" not in grader_targets,
        "grader can read tutor config",
        failures,
    )
    require(
        "/run/adaptive-tutor-grader" in grader_targets,
        "grader socket volume is missing",
        failures,
    )
    require(
        "/run/adaptive-tutor-grader" in worker_targets,
        "worker cannot reach grader socket",
        failures,
    )
    worker_socket_mounts = [
        str(volume)
        for volume in worker_volumes
        if ":/run/adaptive-tutor-grader" in str(volume)
    ]
    grader_socket_mounts = [
        str(volume)
        for volume in grader_volumes
        if ":/run/adaptive-tutor-grader" in str(volume)
    ]
    require(
        len(worker_socket_mounts) == 1
        and worker_socket_mounts[0].endswith(":/run/adaptive-tutor-grader:ro"),
        "worker grader socket volume must be read-only",
        failures,
    )
    require(
        len(grader_socket_mounts) == 1
        and grader_socket_mounts[0].endswith(":/run/adaptive-tutor-grader"),
        "grader socket volume must remain writable",
        failures,
    )
    require(
        all("codex" not in target for target in worker_targets),
        "worker can read model credentials",
        failures,
    )
    runtime_revision = "${SOURCE_REVISION:?Run ./prepare-compose.sh from deploy first}"
    for name in ("tutor", "worker"):
        environment = services.get(name, {}).get("environment", {})
        require(
            environment.get("ADAPTIVE_TUTOR_SOURCE_REVISION") == runtime_revision,
            f"{name} runtime is not pinned to the exact source revision",
            failures,
        )
    require(
        operator.get("environment", {}).get("ADAPTIVE_TUTOR_SOURCE_REVISION")
        == runtime_revision,
        "operator runtime is not pinned to the exact source revision",
        failures,
    )
    require(
        isinstance(proxy, dict) and proxy.get("profiles") == ["live"],
        "TLS proxy must be explicitly live-profile gated",
        failures,
    )
    require(
        isinstance(proxy, dict)
        and "@sha256:" in str(proxy.get("image", ""))
        and proxy.get("read_only") is True,
        "TLS proxy image must be digest-pinned with a read-only root",
        failures,
    )
    require(
        isinstance(proxy, dict)
        and proxy.get("cap_drop") == ["ALL"]
        and proxy.get("cap_add") == ["NET_BIND_SERVICE"],
        "TLS proxy must retain only the bind-service capability",
        failures,
    )
    require(
        (ROOT / "deploy" / "Caddyfile").is_file(),
        "automatic TLS proxy configuration is missing",
        failures,
    )


def validate_dockerfile(failures: list[str]) -> None:
    path = ROOT / "Dockerfile"
    try:
        content = path.read_text(encoding="utf-8")
    except OSError as exc:
        failures.append(f"Dockerfile is unreadable: {exc}")
        return
    from_lines = [line for line in content.splitlines() if line.startswith("FROM ")]
    require(bool(from_lines), "Dockerfile has no build stages", failures)
    require(
        all("@sha256:" in line for line in from_lines),
        "every container base image must be digest-pinned",
        failures,
    )
    require("USER 10001:10001" in content, "container must run as a non-root user", failures)
    require("uv sync --locked" in content, "container dependencies must use uv.lock", failures)
    require("@openai/codex@${CODEX_VERSION}" in content, "Codex CLI must be pinned", failures)
    require(
        "GITHUB_CLI_VERSION=2.97.0" in content
        and "COPY --from=github-cli /usr/local/bin/gh /usr/local/bin/gh" in content,
        "GitHub CLI must be pinned and installed in the runtime image",
        failures,
    )
    require(
        "ca-certificates git libstdc++6" in content,
        "Git must be installed in the runtime image",
        failures,
    )

    ignore_path = ROOT / ".dockerignore"
    try:
        ignored = set(ignore_path.read_text(encoding="utf-8").splitlines())
    except OSError as exc:
        failures.append(f".dockerignore is unreadable: {exc}")
    else:
        require(
            {".env", "**/.env"}.issubset(ignored),
            "Docker build context must exclude owner-only environment files",
            failures,
        )


def _volume_targets(volumes: list[Any]) -> set[str]:
    targets: set[str] = set()
    for item in volumes:
        value = str(item)
        if value.endswith((":ro", ":rw")):
            value = value.rsplit(":", 1)[0]
        targets.add(value.rsplit(":", 1)[-1])
    return targets


def validate_systemd(failures: list[str]) -> None:
    unit_root = ROOT / "deploy" / "systemd"
    required = {
        "adaptive-tutor.service",
        "adaptive-tutor-worker.service",
        "adaptive-tutor-grader.service",
        "adaptive-tutor-backup.service",
        "adaptive-tutor-backup.timer",
    }
    present = {path.name for path in unit_root.glob("adaptive-tutor*")}
    require(required.issubset(present), "systemd service/timer set is incomplete", failures)
    for name in required - {"adaptive-tutor-backup.timer"}:
        content = (unit_root / name).read_text(encoding="utf-8")
        for directive in (
            "NoNewPrivileges=true",
            "ProtectSystem=strict",
            "PrivateTmp=true",
            "CapabilityBoundingSet=",
            "Restart=on-failure" if name != "adaptive-tutor-backup.service" else "Type=oneshot",
        ):
            require(directive in content, f"{name} is missing {directive}", failures)
    timer = (unit_root / "adaptive-tutor-backup.timer").read_text(encoding="utf-8")
    require("Persistent=true" in timer, "backup timer must catch up after downtime", failures)
    grader = (unit_root / "adaptive-tutor-grader.service").read_text(encoding="utf-8")
    worker = (unit_root / "adaptive-tutor-worker.service").read_text(encoding="utf-8")
    tutor = (unit_root / "adaptive-tutor.service").read_text(encoding="utf-8")
    backup = (unit_root / "adaptive-tutor-backup.service").read_text(encoding="utf-8")
    require("User=adaptive-tutor-grader" in grader, "grader must use its own UID", failures)
    require("Group=adaptive-tutor-grader" in grader, "grader must use its private group", failures)
    require(
        "SupplementaryGroups=adaptive-tutor-grader-socket" in grader,
        "grader must join only the shared socket group",
        failures,
    )
    require(
        "EnvironmentFile=-/etc/adaptive-tutor-grader/grader.env" in grader,
        "grader credential file must be outside tutor-controlled configuration",
        failures,
    )
    require("RuntimeDirectoryMode=0750" in grader, "grader socket directory must be 0750", failures)
    require(
        "--socket-group adaptive-tutor-grader-socket" in grader,
        "grader must create a group-scoped socket",
        failures,
    )
    require(
        "InaccessiblePaths=/var/lib/adaptive-tutor /etc/adaptive-tutor "
        "/etc/adaptive-tutor-grader" in grader,
        "grader must not see tutor state or configuration",
        failures,
    )
    require(
        "SupplementaryGroups=adaptive-tutor-grader-socket" in worker,
        "worker must join the grader socket group",
        failures,
    )
    worker_write_paths = next(
        (line for line in worker.splitlines() if line.startswith("ReadWritePaths=")), ""
    )
    require(
        "/run/adaptive-tutor-grader" not in worker_write_paths,
        "worker must not be able to alter the grader socket directory",
        failures,
    )
    require(
        "InaccessiblePaths=/var/lib/adaptive-tutor-grader /etc/adaptive-tutor-grader"
        in worker,
        "worker must not see grader credentials or Codex state",
        failures,
    )
    for name, content in (("tutor", tutor), ("backup", backup)):
        require(
            "SupplementaryGroups=adaptive-tutor-grader-socket" not in content,
            f"{name} must not join the grader socket group",
            failures,
        )
        require(
            "InaccessiblePaths=/var/lib/adaptive-tutor-grader "
            "/etc/adaptive-tutor-grader -/run/adaptive-tutor-grader" in content,
            f"{name} must not see grader state, credentials, or socket",
            failures,
        )
    require(
        "ReadWritePaths=/etc/adaptive-tutor /var/lib/adaptive-tutor" in tutor,
        "tutor service must allow authenticated guided-setup configuration writes",
        failures,
    )


def validate_operations(failures: list[str]) -> None:
    path = ROOT / "docs" / "operations.md"
    try:
        content = path.read_text(encoding="utf-8").lower()
    except OSError as exc:
        failures.append(f"operations guide is unreadable: {exc}")
        return
    for topic in (
        "install",
        "configure",
        "start",
        "stop",
        "restart",
        "status",
        "logs",
        "backup",
        "restore",
        "upgrade",
        "rollback",
        "failure recovery",
    ):
        require(topic in content, f"operations guide does not cover {topic}", failures)


def validate_with_tools(failures: list[str]) -> None:
    prepare = ROOT / "deploy" / "prepare-compose.sh"
    shell_path = shutil.which("sh")
    require(shell_path is not None, "POSIX shell is unavailable", failures)
    if shell_path is None:
        return
    shell = subprocess.run(  # noqa: S603 - resolved trusted executable and fixed arguments
        [shell_path, "-n", str(prepare)], check=False
    )
    require(shell.returncode == 0, "prepare-compose.sh has invalid shell syntax", failures)
    docker_path = shutil.which("docker")
    if docker_path:
        with tempfile.TemporaryDirectory(prefix="adaptive-tutor-compose-check-") as temp:
            root = Path(temp)
            env_file = root / "compose.env"
            runtime = root / "runtime"
            env_file.write_text(
                f"TUTOR_RUNTIME_DIR={runtime}\nTUTOR_UID=1000\nTUTOR_GID=1000\n"
                f"SOURCE_REVISION={'a' * 40}\nTUTOR_DOMAIN=tutor.example.test\n",
                encoding="utf-8",
            )
            compose = subprocess.run(  # noqa: S603 - resolved executable and fixed arguments
                [
                    docker_path,
                    "compose",
                    "--env-file",
                    str(env_file),
                    "-f",
                    "deploy/compose.yaml",
                    "config",
                    "--quiet",
                ],
                cwd=ROOT,
                check=False,
                capture_output=True,
                text=True,
            )
        require(
            compose.returncode == 0,
            "docker compose rejected deploy/compose.yaml: " + compose.stderr.strip(),
            failures,
        )


def main() -> int:
    failures: list[str] = []
    payload = load_compose(failures)
    validate_compose(payload, failures)
    validate_dockerfile(failures)
    validate_systemd(failures)
    validate_operations(failures)
    validate_with_tools(failures)
    if failures:
        print("Deployment validation failed:", file=sys.stderr)
        for failure in failures:
            print(f"  - {failure}", file=sys.stderr)
        return 1
    print("Deployment validation: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
