#!/usr/bin/env python3
"""Exercise the hardened Compose runtime and write sanitized public evidence."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import sqlite3
import subprocess
import tempfile
import time
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
DEFAULT_EVIDENCE = ROOT / "implementation" / "evidence" / "deployed-runtime.json"
SOURCE_FILES = (
    ".dockerignore",
    "Dockerfile",
    "deploy/compose.yaml",
    "deploy/prepare-compose.sh",
    "scripts/prove-deployed-runtime",
    "src/adaptive_tutor/cli.py",
    "src/adaptive_tutor/config.py",
    "src/adaptive_tutor/dashboard.py",
    "src/adaptive_tutor/db.py",
)


def _run(
    command: list[str],
    *,
    env: dict[str, str],
    capture: bool = True,
    timeout: int = 900,
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(  # noqa: S603 - fixed tools and repository-owned arguments.
        command,
        cwd=ROOT,
        env=env,
        capture_output=capture,
        text=True,
        check=False,
        timeout=timeout,
    )
    if result.returncode:
        detail = ((result.stdout or "") + (result.stderr or ""))[-4000:]
        raise RuntimeError(f"command failed ({command[0]}):\n{detail}")
    return result


def _source_digest() -> str:
    digest = hashlib.sha256()
    for value in SOURCE_FILES:
        digest.update(value.encode())
        digest.update(b"\0")
        digest.update((ROOT / value).read_bytes())
        digest.update(b"\0")
    return "sha256:" + digest.hexdigest()


def _wait_container_healthy(
    container_id: str, env: dict[str, str], *, timeout: int = 90
) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            details = _container_details(container_id, env)
            state = dict(details.get("State") or {})
            health = dict(state.get("Health") or {})
            if state.get("Running") is True and health.get("Status") == "healthy":
                return
        except (OSError, RuntimeError, ValueError):
            pass
        time.sleep(1)
    raise RuntimeError("Compose tutor did not become ready")


def _container_request(
    container_id: str,
    path: str,
    *,
    authenticated: bool,
    env: dict[str, str],
) -> tuple[int, bytes]:
    program = """
import json
import pathlib
import sys
import urllib.error
import urllib.request

headers = {}
if sys.argv[2] == "authenticated":
    values = {}
    for line in pathlib.Path("/var/lib/adaptive-tutor/secrets.env").read_text().splitlines():
        name, separator, value = line.partition("=")
        if separator:
            values[name] = value
    headers["Authorization"] = "Bearer " + values["ADAPTIVE_TUTOR_API_TOKEN"]
request = urllib.request.Request("http://127.0.0.1:8765" + sys.argv[1], headers=headers)
try:
    with urllib.request.urlopen(request, timeout=5) as response:
        status, body = response.status, response.read().decode()
except urllib.error.HTTPError as error:
    status, body = error.code, error.read().decode()
print(json.dumps({"status": status, "body": body}))
"""
    result = _run(
        [
            "docker",
            "exec",
            container_id,
            "python",
            "-c",
            program,
            path,
            "authenticated" if authenticated else "anonymous",
        ],
        env=env,
    )
    payload = json.loads(result.stdout)
    return int(payload["status"]), str(payload["body"]).encode()


def _crash_service_process(container_id: str, env: dict[str, str]) -> None:
    program = """
import os
import signal

for name in sorted(os.listdir("/proc"), key=lambda value: int(value) if value.isdigit() else -1):
    if not name.isdigit() or int(name) in {1, os.getpid()}:
        continue
    try:
        status = open(f"/proc/{name}/status", encoding="utf-8").read()
    except (FileNotFoundError, PermissionError):
        continue
    parent = next(
        (
            line.partition(":")[2].strip()
            for line in status.splitlines()
            if line.startswith("PPid:")
        ),
        "",
    )
    if parent == "1":
        os.kill(int(name), signal.SIGKILL)
        print("service process terminated")
        break
else:
    raise SystemExit("service child process not found")
"""
    _run(["docker", "exec", container_id, "python", "-c", program], env=env)


def _prepare_runtime(runtime: Path, uid: int, gid: int) -> None:
    runtime.mkdir(mode=0o700)
    for name in ("codex", "config", "grader-run", "state"):
        target = runtime / name
        target.mkdir(mode=0o700)
    for name in ("tutor.env", "worker.env", "grader.env"):
        target = runtime / name
        target.write_text("", encoding="utf-8")
        target.chmod(0o600)
    if os.geteuid() == 0:
        for target in (runtime, *runtime.iterdir()):
            os.chown(target, uid, gid)


def _compose_command(project: str, *arguments: str) -> list[str]:
    return [
        "docker",
        "compose",
        "--env-file",
        os.devnull,
        "--project-name",
        project,
        "-f",
        "deploy/compose.yaml",
        *arguments,
    ]


def _container_details(container_id: str, env: dict[str, str]) -> dict[str, Any]:
    output = _run(["docker", "inspect", container_id], env=env).stdout
    payload = json.loads(output)
    if not isinstance(payload, list) or len(payload) != 1:
        raise RuntimeError("docker inspect returned an unexpected payload")
    return dict(payload[0])


def _sqlite_integrity(path: Path) -> str:
    connection = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
    try:
        row = connection.execute("PRAGMA integrity_check").fetchone()
    finally:
        connection.close()
    return str(row[0]) if row else "missing"


def _git_revision(env: dict[str, str]) -> str:
    return _run(["git", "rev-parse", "HEAD"], env=env).stdout.strip()


def _image_revision(env: dict[str, str]) -> str:
    output = _run(
        [
            "docker",
            "image",
            "inspect",
            "adaptive-tutor:local",
            "--format",
            "{{ index .Config.Labels \"org.opencontainers.image.revision\" }}",
        ],
        env=env,
    ).stdout
    return output.strip()


def prove(evidence_path: Path, *, build_image: bool) -> None:
    if shutil.which("docker") is None:
        raise RuntimeError("Docker is required for deployed-runtime proof")
    base_env = dict(os.environ)
    _run(["docker", "info"], env=base_env)
    project = f"adaptive-tutor-proof-{os.getpid()}"
    runtime_uid = 10001 if os.geteuid() == 0 else os.geteuid()
    runtime_gid = 10001 if os.geteuid() == 0 else os.getegid()
    shared_temporary_root = ROOT / "artifacts"
    shared_temporary_root.mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(
        prefix="adaptive-tutor-runtime-proof-", dir=shared_temporary_root
    ) as temporary:
        runtime = Path(temporary) / "runtime"
        _prepare_runtime(runtime, runtime_uid, runtime_gid)
        source_revision = _git_revision(base_env)
        env = {
            **base_env,
            "SOURCE_REVISION": source_revision,
            "TUTOR_GID": str(runtime_gid),
            "TUTOR_PORT": "0",
            "TUTOR_RUNTIME_DIR": str(runtime),
            "TUTOR_UID": str(runtime_uid),
        }
        compose = lambda *args: _compose_command(project, *args)  # noqa: E731
        try:
            if build_image:
                _run(compose("build", "tutor"), env=env, capture=False)
            image_revision_matches = _image_revision(env) == source_revision
            if not image_revision_matches:
                raise RuntimeError("runtime image revision does not match the checked-out commit")
            _run(compose("--profile", "tools", "run", "--rm", "initializer"), env=env)
            _run(compose("up", "--detach", "tutor"), env=env)
            container_id = _run(compose("ps", "--quiet", "tutor"), env=env).stdout.strip()
            if not container_id:
                raise RuntimeError("Compose tutor container is missing")
            _wait_container_healthy(container_id, env)
            ready_status, _ = _container_request(
                container_id, "/readyz", authenticated=False, env=env
            )
            unauthenticated_status, _ = _container_request(
                container_id, "/api/v1/get_status", authenticated=False, env=env
            )
            authenticated_status, status_body = _container_request(
                container_id, "/api/v1/get_status", authenticated=True, env=env
            )
            status_payload = json.loads(status_body)
            if not isinstance(status_payload, dict) or "active_curriculum" not in status_payload:
                raise RuntimeError("authenticated status API returned an invalid payload")

            before = _container_details(container_id, env)
            config = dict(before.get("Config") or {})
            host_config = dict(before.get("HostConfig") or {})
            port_bindings = dict(host_config.get("PortBindings") or {})
            bindings = port_bindings.get("8765/tcp") or []
            non_root = str(config.get("User", "")).split(":", 1)[0] not in {"", "0", "root"}
            loopback = bool(bindings) and all(
                str(item.get("HostIp")) == "127.0.0.1" for item in bindings
            )
            immutable_root = host_config.get("ReadonlyRootfs") is True
            dropped_capabilities = "ALL" in (host_config.get("CapDrop") or [])
            no_privilege_escalation = "no-new-privileges:true" in (
                host_config.get("SecurityOpt") or []
            )

            _crash_service_process(container_id, env)
            _wait_container_healthy(container_id, env)
            after = _container_details(container_id, env)
            restart_count = int(after.get("RestartCount") or 0)
            recovered_status, recovered_body = _container_request(
                container_id,
                "/api/v1/get_status",
                authenticated=True,
                env=env,
            )
            state_persisted = json.loads(recovered_body) == status_payload

            backup_name = "deployed-runtime-proof.sqlite3"
            _run(
                compose(
                    "exec",
                    "--no-TTY",
                    "tutor",
                    "adaptive-tutor",
                    "backup",
                    f"/var/lib/adaptive-tutor/backups/{backup_name}",
                ),
                env=env,
            )
            backup = runtime / "state" / "backups" / backup_name
            backup_integrity = _sqlite_integrity(backup)
            with sqlite3.connect(backup) as connection:
                migration_row = connection.execute(
                    "SELECT COUNT(*) FROM schema_migrations"
                ).fetchone()
            migration_count = int(migration_row[0]) if migration_row else 0

            assertions = {
                "authenticated_api": authenticated_status == 200,
                "authorization_enforced": unauthenticated_status == 401,
                "backup_integrity": backup_integrity == "ok",
                "capabilities_dropped": dropped_capabilities,
                "crash_restart_recovered": restart_count >= 1 and recovered_status == 200,
                "immutable_root_filesystem": immutable_root,
                "image_revision_matches": image_revision_matches,
                "loopback_binding": loopback,
                "migrations_applied": migration_count > 0,
                "no_privilege_escalation": no_privilege_escalation,
                "non_root_runtime": non_root,
                "persistent_state_recovered": state_persisted,
                "readiness_healthy": ready_status == 200,
            }
            failed = [name for name, passed in assertions.items() if not passed]
            if failed:
                raise RuntimeError("deployment assertions failed: " + ", ".join(failed))
            evidence = {
                "schema_version": "1.0",
                "evidence_kind": "deployed_runtime",
                "generated_at": datetime.now(UTC).isoformat(timespec="seconds"),
                "source_revision": env["SOURCE_REVISION"],
                "source_files": list(SOURCE_FILES),
                "source_digest": _source_digest(),
                "deployment_path": "docker_compose",
                "runtime": "disposable_local_container",
                "assertions": assertions,
                "observations": {
                    "authenticated_status": authenticated_status,
                    "backup_integrity": backup_integrity,
                    "migration_count": migration_count,
                    "readiness_status": ready_status,
                    "restart_count": restart_count,
                    "unauthenticated_status": unauthenticated_status,
                },
                "sanitized": True,
            }
            evidence_path.parent.mkdir(parents=True, exist_ok=True)
            evidence_path.write_text(
                json.dumps(evidence, indent=2, sort_keys=True) + "\n", encoding="utf-8"
            )
        except (OSError, RuntimeError, ValueError) as exc:
            logs = subprocess.run(  # noqa: S603 - fixed Docker diagnostics command.
                compose("logs", "--no-color", "--tail", "80", "tutor"),
                cwd=ROOT,
                env=env,
                capture_output=True,
                text=True,
                check=False,
                timeout=30,
            )
            detail = (logs.stdout + logs.stderr)[-4000:]
            raise RuntimeError(f"{exc}\nCompose diagnostics:\n{detail}") from exc
        finally:
            _run(
                compose("down", "--remove-orphans"),
                env=env,
                timeout=180,
            )
    try:
        displayed_path = evidence_path.relative_to(ROOT)
    except ValueError:
        displayed_path = Path(evidence_path.name)
    print(f"Deployed runtime proof: PASS ({displayed_path})")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--evidence", type=Path, default=DEFAULT_EVIDENCE)
    parser.add_argument(
        "--skip-build",
        action="store_true",
        help="Use adaptive-tutor:local after verifying its source-revision label.",
    )
    args = parser.parse_args()
    try:
        prove(args.evidence.resolve(), build_image=not args.skip_build)
    except (OSError, RuntimeError, ValueError, subprocess.TimeoutExpired) as exc:
        print(f"Deployed runtime proof failed: {exc}")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
