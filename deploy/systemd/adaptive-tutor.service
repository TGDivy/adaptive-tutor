[Unit]
Description=Adaptive Tutor dashboard and webhook service
Documentation=https://tgdivy.github.io/adaptive-tutor/operations/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=adaptive-tutor
Group=adaptive-tutor
WorkingDirectory=/var/lib/adaptive-tutor
Environment=ADAPTIVE_TUTOR_CONFIG=/etc/adaptive-tutor/config.yaml
Environment=HOME=/var/lib/adaptive-tutor
EnvironmentFile=-/etc/adaptive-tutor/tutor.env
ExecStart=/opt/adaptive-tutor/bin/adaptive-tutor serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/adaptive-tutor
InaccessiblePaths=/var/lib/adaptive-tutor-grader /etc/adaptive-tutor-grader -/run/adaptive-tutor-grader
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
