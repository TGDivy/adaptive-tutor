[Unit]
Description=Create an online Adaptive Tutor SQLite backup
Documentation=https://tgdivy.github.io/adaptive-tutor/operations/#backup-and-restore

[Service]
Type=oneshot
User=adaptive-tutor
Group=adaptive-tutor
WorkingDirectory=/var/lib/adaptive-tutor
Environment=ADAPTIVE_TUTOR_CONFIG=/etc/adaptive-tutor/config.yaml
Environment=HOME=/var/lib/adaptive-tutor
ExecStart=/opt/adaptive-tutor/bin/adaptive-tutor backup
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/adaptive-tutor
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
